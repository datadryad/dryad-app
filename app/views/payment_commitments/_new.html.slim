h1 id="dialog-title" Add new contract
 - if flash[:alert]
    .js-alert.c-alert--error role="alert"
      .c-alert__text
        = flash[:alert]

= form_with url: payment_commitments_path, method: :post, local: false do |f|
  .c-input
    label.c-input__label [for=:commitment_years] Commitment years:
    = f.number_field :commitment_years, value: params[:commitment_years], class: 'c-input__text'
  .c-input
    label.c-input__label [for=:start_date] Start date:
    = f.date_field :start_date, value: params[:start_date], class: 'c-input__text'
  .c-input
    label.c-input__label [for=:include_year_0]
      | Include year 0:
      = f.checkbox :include_year_0, style: "margin-left: 10px"
  .c-input
    label.c-input__label [for=:asf] Annual Service Fee:
    = f.number_field :asf, value: params[:asf], class: 'c-input__text'
  .c-input
    label.c-input__label [for=:consortium_discount] Consortium discount:
    = f.number_field :consortium_discount, value: params[:consortium_discount], class: 'c-input__text'
  .c-input
    label.c-input__label [for=:dpc_tier] Data Publishing Charge (DPC) tier:
    = f.number_field :dpc_tier, value: params[:dpc_tier], class: 'c-input__text'
  .c-input
    label.c-input__label [for=:ldf_size_limit] Limit file size for Large Data billed to partner
    = f.number_field :ldf_size_limit, value: params[:ldf_size_limit], class: 'c-input__text'
  .c-input
    label.c-input__label [for=:ldf_commitment] Large Data Fee:
    = f.number_field :ldf_commitment, value: params[:ldf_commitment], class: 'c-input__text'
  .c-input
    label.c-input__label [for=:asf_prepaid] Prepayment requested | Add total if applicable:
    = f.number_field :asf_prepaid, value: params[:asf_prepaid], class: 'c-input__text'
  .c-modal__buttons-right
    = submit_tag 'Save', class: 'o-button__plain-text2'
    = button_tag 'Cancel', type: 'button', id: 'cancel_dialog', class:'o-button__plain-text7'
