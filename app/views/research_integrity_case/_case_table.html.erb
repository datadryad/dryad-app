<%= form_with(url: request.path, method: 'get') do %>
<div class="o-admin-form-inline">
  <div class="o-admin-form-pair">
    <label for="search-terms">Cases search:</label>
    <%= search_field_tag(:q, params[:q], class: 'c-input__text', id: 'search-terms' ) %>
  </div>
  <%= submit_tag('Search', name: nil, class: 'o-button__plain-text2' ) %>
</div>
<% end %>

<div class="table-wrapper c-lined-table-wrapper" role="region" tabindex="0" aria-labelledby="deleted-label">
<table class="c-lined-table">
  <thead>
    <tr><th>Dataset</th><th>SF Cases</th><th style="width:50%">Notes</th><th style="width: 40px">Resolved</th></tr>
  </thead>
  <tbody>
  <% @cases.each do |c| %>
    <tr>
      <td>
        <div class="c-lined-table__with-actions">
          <div class="c-lined-table__data">
            <%= link_to c.resource.title, show_path(id: c.resource.identifier_str) %>
          </div>
          <div class="c-lined-table__actions">
            <a title="Activity log" aria-label="Activity log" href="<%= activity_log_path(id: c.identifier_id) %>" class="c-admin-edit-icon">
              <i class="fa fa-clock" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </td>
      <td>
        <% if c.salesforce_links.present? %>
          <%= c.salesforce_links.map{|sf| link_to(sf.title, sf.path, target: '_blank')}.join('<br/>').html_safe %>
        <% end %>
      </td>
      <td id="notes<%=c.id%>">
        <%= render partial: 'notes', locals: {c: c} %>
      </td>
      <th style="text-align: center;" id="resolver<%=c.id%>">
        <%= render partial: 'resolver', locals: {c: c} %>
      </th>
    </tr>
  <% end %>
  </tbody>
</table>
</div>

<div class="c-space-paginator">
  <%= paginate @cases, params: { page_size: @page_size } %>
  <div class="c-paginator-page_size">
    Page size:
    <%
      current_ps = params[:page_size].to_i
      current_ps = 10 if current_ps == 0
      [10, 50, 100].each do |ps| %>
      <% if ps == current_ps %>
        <span class="page-current"><%= ps %></span>
      <% else %>
        <%= link_to(ps, request.params.except(:action, :controller).merge(page_size: ps, page: 1), 'aria-label': "#{ps} results per page") %>
      <% end %>
    <% end %>
  </div>
</div>