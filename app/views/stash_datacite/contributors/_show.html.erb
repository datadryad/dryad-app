<% unless contributors.nil? || contributors.length < 1 || (contributors.length == 1 && contributors[0].contributor_name_friendly == 'N/A') %>
  <div id="show_funding">
  	<h2>Funding</h2>
    <ul class="o-list">
      <% contributors.to_a.group_by{|c| [c.identifier_type, c.name_identifier_id, c.contributor_name]}.each do |group| %>
        <% ror_funder = group.first.second.present? && group.first.first == 'ror' %>
        <% contributor = group.last.first %>
        <li>
          <% if ror_funder%><a href="<%= new_search_path(org: contributor.name_identifier_id) %>"><%= contributor.contributor_name_friendly%></a><%
          else 
            %><span><%= contributor.contributor_name_friendly%><%if current_user&.min_app_admin? && contributor.name_identifier_id.blank? %><i class="fas fa-triangle-exclamation unmatched-icon" role="note" aria-label="Unmatched funder" title="Unmatched funder"></i><%end%></span><% 
          end 
          %><%= awards_display(group.last, ror_funder)&.html_safe %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
