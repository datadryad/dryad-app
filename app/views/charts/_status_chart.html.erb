<%
status = @data.reject { |k,v| v.to_i.zero? }
status_desc = status.map {|k,v| "#{k.to_s.humanize}: #{v}" }.join(', ')
%>
<canvas <% if status.length < 2 %>hidden<% end %> id="status-chart" role="img" aria-label="Bar chart counting datasets based on publication and workflow status. <%= status_desc %>"></canvas>
<script>
  new Chart(document.getElementById('status-chart').getContext('2d'), {
    type: 'bar',
    data: {
      labels: <%= status.keys.map{|k| k.to_s.humanize}.to_json.html_safe %>,
      datasets: [{ 
        data: <%= status.values.to_json.html_safe %>,
        backgroundColor: ['rgb(255, 99, 132)', 'rgb(255, 159, 64)', 'rgb(255, 205, 86)', 'rgb(75, 192, 192)', 'rgb(54, 162, 235)']
      }]
    },
    options: {
      //indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        title: { display: true, text: 'Dataset states', font: { size: 20 } }
      }
    }
  })
</script>