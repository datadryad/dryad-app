<% @page_title = 'Dryad | Partner dashboard' %>
<div class="admin-dashboard-header">
  <h1 class="admin-dashboard-results" style="row-gap: 0; column-gap: 1ch">
    <%= @sponsor_details.name %>
    <span style="color: black; font-size: 1.25rem;">Partner dashboard</span>
  </h1>
  <div class="expand-button" style="position: relative">
    <button aria-controls="partner-links" aria-expanded="false" style="text-align: right;">Quick links</button>
    <nav id="partner-links" class="quick-links" aria-label="Quick links for partners" hidden>
      <ul class="o-list">
        <li><a href="/admin_dashboard">Admin dashboard</a></li>
        <li><a href="/<%= @sponsor.is_a?(StashEngine::Tenant) ? 'institutions' : 'publishers' %>#fee-calculator">Partner fees</a></li>
        <li><a href="/help/requirements/costs#your-data-publishing-charge">User fee calculator</a></li>
      </ul>
    </nav>
  </div>
</div>
<div class="partner-dashboard">
  <%= render partial: 'details' %>
</div>
<%= form_with(url: request.path, method: 'get') do %>
<div class="admin-dashboard-results" style="margin-top: 1.5rem; justify-content: space-between;">
  <b id="id_head" role="heading" aria-level="2" style="font-size: 1.35em;">Sponsored datasets</b>
  <div class="admin-dashboard-results">
  <% if @years.length > 1 %>
    <div class="o-admin-form-pair">
      <label for="year">Year:</label>
      <%= select_tag :year, options_for_select(@years, @calculation_year), class: 'c-input__select' %>
    </div>
  <% end %>
  <div class="o-admin-form-pair">
    <label for="status">Fee status:</label>
    <%= select_tag :status, options_for_select([['All', ''], ['Spent', 'publicly_viewable'], ['Reserved', 'unpublished']], params[:status]), class: 'c-input__select' %>
  </div>
   <%= submit_tag('Apply', name: nil, class: 'o-button__plain-text2' ) %>
</div>
</div>
<% end %>
<%= render partial: 'identifiers' %>