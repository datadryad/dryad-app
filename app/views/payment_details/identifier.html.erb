<%= stylesheet_link_tag 'payment_details' %>
<h1>Developer details: <%= @identifier.latest_resource.title %></h1>
<div class="input-line">
  <p><b>ID:</b> <%= @identifier.id %></p>
  <p><b>DOI:</b> <%= @identifier %></p>
  <p><%= link_to 'Activity log', activity_log_path(@identifier) %></p>
</div>
<h2>Payment JSONs</h2>
<div class="payment-tables">
  <% if @payment_sponsor %>
  <div>
    <div class="admin-dashboard-results">
      <h3>Payment sponsor</h3>
      <%= link_to "#{@payment_sponsor_details.name} ( #{@payment_sponsor.id} )", payment_details_sponsor_path(id: @payment_sponsor.id, type: @payment_sponsor.class.name) %>
    </div>
    <pre><code><%= JSON.pretty_generate(@payment_sponsor.payment_configuration&.attributes) %></code></pre>
  </div>
  <% end %>
  <% if @limits_sponsor %>
  <div>
    <div class="admin-dashboard-results">
      <h3>Payment limits</h3>    
      <%= link_to "#{@limits_sponsor_details.name} ( #{@limits_sponsor.id} )", payment_details_sponsor_path(id: @limits_sponsor.id, type: @limits_sponsor.class.name) %>
    </div>
    <pre><code><%= JSON.pretty_generate(@limits_sponsor.payment_configuration&.attributes) %></code></pre>
  </div>
  <% end %>
  <div>
    <h3>Identifier</h3>
    <pre><code><%=
      JSON.pretty_generate(
        @identifier.attributes.slice('payment_type', 'payment_id', 'waiver_basis', 'pub_state', 'publication_date', 'old_payment_system')
          .merge({
                   last_invoiced_file_size: "#{@identifier.last_invoiced_file_size} (#{filesize(@identifier.last_invoiced_file_size)})",
                 })
      )
    %></code></pre>
  </div>
  <div>
    <h3>Last resource price calculation (<%= @identifier.latest_resource_id %>)</h3>
    <pre><code><%=
      JSON.pretty_generate(
        @price_calculation
      )
    %></code></pre>
  </div>
</div>

<h2 id="id_head">Payments</h2>

<p>Total LDF: <%= number_to_currency(@total_ldf) %></p>
<p><%= number_with_delimiter(@identifier.resources.count) %> Resources: </p>
<div class="table-wrapper c-lined-table-wrapper" style="margin-top: .5rem" tabindex="0" role="region" aria-labelledby="id_head">
  <table class="c-lined-table" style="font-size: .9rem;">
    <thead>
      <tr>
        <th>Version</th>
        <th>ID</th>
        <th>Status</th>
        <th>Status date</th>
        <th>Size</th>
        <th>Sponsored LDF</th>
        <th>User paid</th>
      </tr>
    <tbody>
    <% @identifier.resources.includes(:last_curation_activity, :sponsored_payment_log, :payment, :stash_version).each do |res| %>
      <tr>
        <td><%= res.stash_version.version %></td>
        <td><%= res.id %></td>
        <td><%= res.last_curation_activity.status %></td>
        <td><%= res.last_curation_activity.created_at %></td>
        <td><%= filesize res.total_file_size %></td>
        <td class="align-end">
          <%= number_to_currency(res.sponsored_payment_log&.ldf) %>
        </td>
        <td class="align-end">
          <% if res.payment&.paid? %>
            <%= number_to_currency(res.payment&.amount) %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
