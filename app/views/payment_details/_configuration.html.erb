<div>
  <% if @sponsor.payment_sponsor.payment_configuration&.payment_plan&.present? %>
    <b>Plan:</b> <%= @sponsor.payment_sponsor.payment_configuration.payment_plan&.humanize %><br/>
    <b>Covers LDF:</b> <%= @sponsor.limits_sponsor.payment_configuration.covers_ldf ? "Yes" : "No" %>
    <% if @sponsor.limits_sponsor.payment_configuration.covers_ldf %>
      <% if @sponsor.limits_sponsor.payment_configuration.ldf_limit.present? %>
        (Up to <%= filesize(ESTIMATED_FILES_SIZE.find{|tier| tier[:tier] == @sponsor.limits_sponsor.payment_configuration.ldf_limit }[:range].max) %>)
      <% end %>
      <% if @sponsor.limits_sponsor.payment_configuration.yearly_ldf_limit.present? %>
        <br/><b>Remaining LDF commitment:</b> <%= number_to_currency(@sponsor.limits_sponsor.payment_configuration.yearly_ldf_limit - @limits_service.total_ldf) %>
      <% end %>
      <% if @sponsor.limits_sponsor.payment_configuration.ldf_limit_notification.present? %>
        <br/><b>LDF contacts:</b> <%= @sponsor.limits_sponsor.payment_configuration.ldf_limit_notification&.join(', ') %>
      <% end %>
    <% end %>
    <% arr = [@sponsor.limits_sponsor, @sponsor.payment_sponsor].uniq.reject{|s| s == @sponsor} %>
    <% if arr.present? %>
      <br/><b>Inherited from:</b> <%= arr.map {|s| "<a href=\"#{payer_payment_details_debug_path(s)}\">#{PayerDetailsService.new(s)details.name}</a>" }.join(', ').html_safe %>
    <% end %>
  <% end %>
</div>
<h3>JSON:</h3>
<pre><code><%= JSON.pretty_generate(@service.payment_configuration&.attributes) %></code></pre>