<% last_payment_type = nil %>
<h1 id="dialog-title">Payment log</h1>
<b role="heading" aria-level="2">Current</b>
<ul class="o-list zebra-list payment-log">
<% @identifier.payment_records.active.each do |log| %>
  <%= render partial: 'payment_log_line', locals: { log: log } %>
<% end %>
</ul>
<% if @identifier.payment_records.inactive.present? %>
  <p style="margin-bottom: 0"><b role="heading" aria-level="2">Canceled</b></p>
  <ul class="o-list zebra-list payment-log" style="text-decoration: strikethrough;">
  <% @identifier.payment_records.inactive.each do |log| %>
    <%= render partial: 'payment_log_line', locals: { log: log } %>
  <% end %>
  </ul>
<% end %>
<div class="c-modal__buttons-right">
  <%= button_tag 'Close', type: 'button', id: 'cancel_dialog', class: 'o-button__plain-text7' %>
</div>