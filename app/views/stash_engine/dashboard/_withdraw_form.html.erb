<% if withdraw_check(params[:id])%>
<h1 id="dialog-title">Withdraw request sent</h1>
<p>Your request to withdraw this dataset has been sent and is being processed.</p>
<% else %>
<h1 id="dialog-title">Contact the helpdesk</h1>
<%= render partial: 'stash_engine/shared/contact_form', locals: {identifier: params[:id], subject: 'Withdraw my dataset', body: 'Reason for withdrawal request:'} %>
<p class='c-modal__buttons-right'><button id='cancel_dialog' class= 'o-button__plain-text7'>Close</button></p>
<% end %>